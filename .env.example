# Copy to .env and fill in. `.env*` is gitignored — never commit real values.

# --- Database (Supabase) -----------------------------------------------------
# Two connection strings, and the difference matters:
#
#   DATABASE_URL  Transaction pooler, port 6543, ?pgbouncer=true.
#                 Used at runtime by @studio/database/prisma. Fine for queries,
#                 cannot run DDL or prepared statements reliably.
#
#   DIRECT_URL    Session mode, port 5432. Used by `prisma migrate` / db push
#                 and by `npm run migrate:c2s`.
#
# IMPORTANT: use the *pooler* host on port 5432 for DIRECT_URL, not
# db.<ref>.supabase.co. Supabase no longer gives that host an IPv4 address, so
# on any IPv4-only network — most CI runners, Cloud Run, App Hosting — it fails
# to resolve and migrations never run. The pooler host is dual-stack.
#
#   Wrong: postgresql://postgres:PW@db.<ref>.supabase.co:5432/postgres
#   Right: postgresql://postgres.<ref>:PW@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Both are under Dashboard > Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase API ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (apps/web/src/lib/supabase-admin.ts). Bypasses row-level
# security entirely — never expose it to the browser or a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase client SDK -----------------------------------------------------
# Console > Project Settings > General > Your apps > SDK setup.
# Required by apps/web and apps/c2s-public (sign-in).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK ------------------------------------------------------
# Local development only: path to a service-account JSON file.
# Leave UNSET on App Hosting / Cloud Run, where Application Default Credentials
# are used — pointing it at a missing file there breaks Admin SDK startup.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=cogdasma.app
TENANT_ID=cog-dasma

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Cron endpoints ----------------------------------------------------------
# Shared secret guarding /api/cron/*.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# ENABLE_WORKER_ID_LOGIN=true
# NEXT_PUBLIC_ENABLE_WORKER_ID_LOGIN=true
# KIOSK_SCANNER_PASSWORD=
# NEXT_PUBLIC_MODULE_URL_C2S=http://localhost:9004

# --- Local emulators (apps/c2s-public testing) -------------------------------
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
